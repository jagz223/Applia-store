# ===========================================
# Applia Store — variables de entorno (ejemplo)
# Copia a `.env` y completa los valores.
# ===========================================

# JWT / sesión
JWT_SECRET=
JWT_EXPIRES_IN=7d
SESSION_SECRET=

# URL pública del frontend (retornos de Stripe / PayPal / dLocal Go + links de correo)
FRONTEND_URL=http://localhost:5000
PUBLIC_SITE_URL=http://localhost:5000
APP_PUBLIC_URL=http://localhost:5000
APP_ORIGIN=http://localhost:5000
CLIENT_ORIGIN=http://localhost:5000
PORT=5000

# ---------- Resend (correo: registro / verify / reset) ----------
RESEND_API_KEY=
MAIL_FROM=Applia <onboarding@resend.dev>

# ---------- AntiRaid (rate limits; opcionales) ----------
# RATE_LIMIT_API_WINDOW_MS=60000
# RATE_LIMIT_API_MAX=120
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_CHECKOUT_WINDOW_MS=60000
# RATE_LIMIT_CHECKOUT_MAX=10

# ---------- Stripe (tienda) ----------
# Dashboard: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ---------- PayPal (tienda) ----------
# Developer: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_MODE=sandbox

# ---------- dLocal Go (tienda) ----------
# Cuenta de prueba: https://dashboard-sbx.dlocalgo.com/signup
# Docs: https://docs.dlocalgo.com/integration-api/welcome-to-dlocal-go-api
DLOCALGO_API_KEY=
DLOCALGO_SECRET_KEY=
# sandbox | live
DLOCALGO_MODE=sandbox
DLOCALGO_CURRENCY=USD
# ISO 3166-1 alpha-2 opcional (AR, BR, MX, PE...). Vacío = el checkout pide el país.
DLOCALGO_COUNTRY=

# ---------- Genlook Virtual Try-On (simulación de ropa) ----------
# Cuenta + créditos gratis: https://platform.genlook.app
# Docs: https://genlook.app/docs/tryon-api/quickstart
GENLOOK_API_KEY=
# true = muestra la sección en el admin de tienda
VITE_STORE_TRY_ON_ENABLED=false

# true = muestra «tamaño por caja» al crear/editar producto y en import Excel
VITE_STORE_BOX_SIZE_ENABLED=false

# ---------- Copy de catálogo de producto (cliente) ----------
# ingredients | materials  (un solo término en toda la UI)
VITE_STORE_CATALOG_ITEM_LABEL=materials
