# ===========================================
# Applia Store — variables de entorno (ejemplo)
# Copia a `.env` y completa los valores.
# ===========================================

# JWT / sesión
JWT_SECRET=
JWT_EXPIRES_IN=7d
SESSION_SECRET=

# URL pública del frontend (retornos de Stripe / PayPal / dLocal Go)
FRONTEND_URL=http://localhost:5000
PUBLIC_SITE_URL=http://localhost:5000
PORT=5000

# ---------- Stripe (tienda) ----------
# Dashboard: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ---------- PayPal (tienda) ----------
# Developer: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_MODE=sandbox

# ---------- dLocal Go (tienda) ----------
# Cuenta de prueba: https://dashboard-sbx.dlocalgo.com/signup
# Docs: https://docs.dlocalgo.com/integration-api/welcome-to-dlocal-go-api
DLOCALGO_API_KEY=
DLOCALGO_SECRET_KEY=
# sandbox | live
DLOCALGO_MODE=sandbox
DLOCALGO_CURRENCY=USD
# ISO 3166-1 alpha-2 opcional (AR, BR, MX, PE...). Vacío = el checkout pide el país.
DLOCALGO_COUNTRY=
