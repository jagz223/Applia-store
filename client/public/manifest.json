const express = require('express');
const path = require('path');
const fs = require('fs');

const app = express();

// Ruta para servir el archivo assetlinks.json
app.get('/.well-known/assetlinks.json', (req, res) => {
  const filePath = path.join(__dirname, 'client/public/assetlinks.json');
  res.sendFile(filePath);
});

// Configuración adicional para servir el frontend
app.use(express.static(path.join(__dirname, 'client/dist')));

