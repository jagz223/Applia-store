# ===========================================
# CONFIGURACIÓN GENFEB S.A.S.
# ===========================================

# Base de Datos
DATABASE_URL=postgresql://mango:mango_pass@localhost:5432/mango_db
ENABLE_DATABASE=false

# Autenticación JWT
JWT_SECRET=genfeb-jwt-secret-key-2024
JWT_EXPIRES_IN=7d
SESSION_SECRET=dev-secret-please-change

# Stripe Pagos
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ===========================================
# FIREBASE CONFIGURATION
# ===========================================
# Ve a https://console.firebase.google.com para crear tu proyecto
# Luego descarga las credenciales del Admin SDK

# ID del proyecto Firebase
FIREBASE_PROJECT_ID=your-firebase-project-id

# Email del cliente (del JSON de credenciales)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# Clave privada (del JSON de credenciales, reemplaza saltos de línea con \n)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"

# ===========================================
# PAYPAL (Opcional)
# ===========================================
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox

# Frontend URL (para callbacks)
FRONTEND_URL=http://localhost:5000
