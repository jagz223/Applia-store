ENABLE_DATABASE=false

# Autenticación JWT
JWT_SECRET=genfeb-jwt-secret-key-2024
JWT_EXPIRES_IN=7d
SESSION_SECRET=dev-secret-please-change

# Stripe Pagos
STRIPE_SECRET_KEY=sk_test_your_stripe_key
