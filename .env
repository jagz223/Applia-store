# ===========================================
# CONFIGURACIÓN GENFEB S.A.S.
# ===========================================

# Base de Datos - Firebase Firestore
# ADVERTENCIA: Cambiar a 'true' solo cuando la base de datos PostgreSQL esté configurada
# Para desarrollo local, mantener en 'false' usando almacenamiento en memoria
DATABASE_URL=postgresql://mango:mango_pass@localhost:5432/mango_db
ENABLE_DATABASE=false

# Autenticación JWT
JWT_SECRET=genfeb-jwt-secret-key-2024
JWT_EXPIRES_IN=7d
SESSION_SECRET=dev-secret-please-change

# Stripe Pagos
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Google Maps (Frontend - VITE prefix required)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

